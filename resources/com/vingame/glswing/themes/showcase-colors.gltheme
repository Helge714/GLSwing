theme.type=colors

font.source=fonts/VT323-Regular.ttf
font.size=19

@COLOR palette.surface=rgba(27, 31, 42, 255)
@COLOR palette.text=rgba(240, 243, 250, 255)
@COLOR palette.textDisabled=rgba(145, 153, 171, 255)
@COLOR palette.textSecondary=rgba(181, 190, 210, 255)
@COLOR palette.border=rgba(78, 89, 112, 255)
@COLOR palette.accent=rgba(255, 174, 66, 255)
@COLOR palette.selection=rgba(181, 100, 30, 220)
@COLOR palette.invalid=rgba(235, 105, 120, 255)

textShadow.color=rgba(0, 0, 0, 180)

state.normal=rgba(45, 52, 68, 255)
state.hover=rgba(72, 67, 86, 255)
state.pressed=rgba(34, 40, 54, 255)
state.disabled=rgba(38, 43, 55, 210)

button.pressedLight=rgba(100, 78, 78, 255)
button.pressedDark=rgba(36, 31, 48, 255)
