# GLSwing default semantic input map
key.history.undo=shortcut+Z
key.history.redo=shortcut+shift+Z, shortcut+Y
key.focus.next=shortcut+TAB
key.focus.previous=shortcut+shift+TAB
modifier.menu.mnemonic=ALT
key.document.new=shortcut+N
key.document.open=shortcut+O
key.document.save=shortcut+S
key.document.save-as=shortcut+shift+S
key.document.save-all=shortcut+alt+S
key.document.close=shortcut+W
value.render.interaction-settle-millis=75
value.node.interactive-curve-tolerance-factor=3

key.control.activate=SPACE, ENTER
key.control.cancel=ESCAPE
key.navigation.up=UP
key.navigation.down=DOWN
key.navigation.left=LEFT
key.navigation.right=RIGHT
key.navigation.home=HOME
key.navigation.end=END
key.navigation.page-up=PAGE_UP
key.navigation.page-down=PAGE_DOWN

modifier.list.extend-selection=SHIFT
modifier.list.toggle-selection=shortcut
key.list.select-all=shortcut+A
key.tree.edit=F2

modifier.slider.precise=SHIFT
modifier.slider.coarse=CTRL
value.slider.precise-factor=0.1
value.slider.coarse-factor=10
modifier.scroll.horizontal=SHIFT

modifier.text.extend-selection=SHIFT
modifier.text.command=shortcut
key.text.select-all=shortcut+A
key.text.copy=shortcut+C
key.text.cut=shortcut+X
key.text.paste=shortcut+V
key.text.move-left=LEFT, shift+LEFT
key.text.move-right=RIGHT, shift+RIGHT
key.text.move-home=HOME, shift+HOME
key.text.move-end=END, shift+END
key.text.backspace=BACK_SPACE
key.text.delete=DELETE
key.text.commit=ENTER
key.text.toggle-bold=shortcut+B
key.text.toggle-italic=shortcut+I
key.text.find=shortcut+F
key.text.replace=shortcut+H
key.text.go-to-line=shortcut+L
value.text.history-coalesce-millis=750

key.code.format=shortcut+shift+F
key.code.comment=shortcut+shift+C
key.code.uncomment=shortcut+alt+C
key.code.complete=shortcut+SPACE
key.code.organizeImports=shortcut+shift+O
key.code.goToDefinition=F3
key.code.navigate-back=ALT+LEFT
key.code.navigate-forward=ALT+RIGHT
key.code.find-references=SHIFT+F12
key.code.rename=F2
key.code.actions=ALT+ENTER

key.node.delete-selection=DELETE, BACK_SPACE
key.node.edit-title=F2
key.node.copy=shortcut+C
key.node.cut=shortcut+X
key.node.paste=shortcut+V
key.node.duplicate=SHIFT+D
key.node.extract-composite=shortcut+G
key.node.select-all=shortcut+A
key.node.create=SHIFT+A
key.node.open-composite=TAB
key.node.move-selection=G
key.node.toggle-hidden=H
key.node.toggle-muted=M
modifier.node.toggle-selection=SHIFT
modifier.node.horizontal-wheel=CTRL
modifier.node.vertical-wheel=SHIFT
