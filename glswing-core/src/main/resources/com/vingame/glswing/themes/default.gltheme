theme.name=Default

font.family=SansSerif
font.style=plain
font.size=12

@COLOR palette.surface=rgba(57, 57, 57, 255)
@COLOR palette.text=rgba(224, 224, 224, 255)
@COLOR palette.textDisabled=rgba(136, 136, 136, 255)
@COLOR palette.textSecondary=rgba(170, 170, 170, 255)
@COLOR palette.border=rgba(37, 37, 37, 255)
@COLOR palette.accent=rgba(84, 120, 181, 255)
@COLOR palette.selection=rgba(69, 105, 166, 191)
@COLOR palette.invalid=rgba(190, 70, 70, 255)

codeEditor.background=rgba(47, 47, 47, 255)
codeEditor.text=rgba(217, 232, 247, 255)
codeEditor.keyword=rgba(204, 108, 29, 255)
codeEditor.string=rgba(23, 198, 163, 255)
codeEditor.number=rgba(104, 151, 187, 255)
codeEditor.comment=rgba(128, 128, 128, 255)
codeEditor.type=rgba(18, 144, 195, 255)
codeEditor.navigationLink=rgba(82, 156, 255, 255)
codeEditor.semantic.namespace=rgba(18, 144, 195, 255)
codeEditor.semantic.type=${codeEditor.type}
codeEditor.semantic.class=rgba(18, 144, 195, 255)
codeEditor.semantic.class.abstract=rgba(62, 171, 230, 255)
codeEditor.semantic.class.static=rgba(177, 102, 218, 255)
codeEditor.semantic.enum=rgba(204, 129, 186, 255)
codeEditor.semantic.interface=rgba(128, 242, 246, 255)
codeEditor.semantic.struct=${codeEditor.type}
codeEditor.semantic.typeParameter=rgba(191, 164, 164, 255)
codeEditor.semantic.parameter=rgba(121, 171, 255, 255)
codeEditor.semantic.variable=rgba(243, 236, 121, 255)
codeEditor.semantic.variable.declaration=rgba(242, 242, 0, 255)
codeEditor.semantic.variable.readonly=rgba(141, 218, 248, 255)
codeEditor.semantic.variable.static=rgba(141, 218, 248, 255)
codeEditor.semantic.property=rgba(102, 225, 248, 255)
codeEditor.semantic.property.readonly=rgba(141, 218, 248, 255)
codeEditor.semantic.property.static=rgba(141, 218, 248, 255)
codeEditor.semantic.enumMember=rgba(141, 218, 248, 255)
codeEditor.semantic.event=rgba(102, 225, 248, 255)
codeEditor.semantic.function=rgba(167, 236, 33, 255)
codeEditor.semantic.function.abstract=rgba(128, 246, 167, 255)
codeEditor.semantic.function.declaration=rgba(30, 181, 64, 255)
codeEditor.semantic.function.definition=rgba(30, 181, 64, 255)
codeEditor.semantic.function.static=rgba(150, 236, 63, 255)
codeEditor.semantic.method=rgba(167, 236, 33, 255)
codeEditor.semantic.method.abstract=rgba(128, 246, 167, 255)
codeEditor.semantic.method.declaration=rgba(30, 181, 64, 255)
codeEditor.semantic.method.definition=rgba(30, 181, 64, 255)
codeEditor.semantic.method.static=rgba(150, 236, 63, 255)
codeEditor.semantic.macro=rgba(177, 102, 218, 255)
codeEditor.semantic.modifier=${codeEditor.keyword}
codeEditor.semantic.regexp=${codeEditor.string}
codeEditor.semantic.operator=rgba(230, 230, 250, 255)
codeEditor.semantic.decorator=rgba(160, 160, 160, 255)
codeEditor.semantic.*.deprecated=rgba(128, 128, 128, 255)

textShadow.color=rgba(0, 0, 0, 0)
textShadow.on=true
textShadow.offsetX=1
textShadow.offsetY=1
textShadow.softness=0
textShadow.offsetSpace=screen

fileDialog.hiddenText=${palette.textSecondary}
fileDialog.hiddenItalic=true

state.normal=rgba(90, 90, 90, 255)
state.hover=rgba(110, 110, 110, 255)
state.pressed=${palette.accent}
state.disabled=rgba(48, 48, 48, 255)

button.pressedLight=rgba(105, 136, 190, 255)
button.pressedDark=rgba(74, 106, 159, 255)

@NUMBER metrics.cornerRadius=4
@NUMBER metrics.borderWidth=1
@NUMBER metrics.controlHeight=22
@INSETS metrics.padding=1,6,1,6

label.text=${palette.text}
label.padding=0,0,0,0

checkBox.boxSize=14
checkBox.gap=6
checkBox.checkStrokeWidth=1.5
checkBox.padding=0,0,0,0

slider.hover=${state.hover}
slider.pressed=rgba(125, 125, 125, 255)
slider.progressLight=rgba(105, 145, 210, 255)
slider.progressDark=rgba(68, 104, 165, 255)
slider.focusProgressLight=${slider.progressLight}
slider.focusProgressDark=${slider.progressDark}
slider.arrowBackground=${state.normal}
slider.arrowHover=${state.hover}
slider.arrowPressed=${palette.accent}
slider.arrowDisabled=${state.disabled}
slider.arrow=${palette.text}
slider.arrowTextDisabled=${palette.textDisabled}
slider.preferredWidth=180
slider.arrowButtonWidth=14
slider.arrowInset=2
slider.arrowStrokeWidth=1.5

numberSpinner.height=28
numberSpinner.preferredWidth=120
numberSpinner.buttonWidth=24
numberSpinner.arrowStrokeWidth=1.5
numberSpinner.cornerRadius=${metrics.cornerRadius}
numberSpinner.borderWidth=${metrics.borderWidth}
numberSpinner.padding=${metrics.padding}

textEditor.background=rgba(42, 42, 42, 255)
textEditor.text=${palette.text}
textEditor.textDisabled=${palette.textDisabled}
textEditor.selection=${palette.selection}
textEditor.searchMatch=rgba(255, 196, 64, 82)
textEditor.searchActiveMatch=rgba(255, 164, 32, 160)
textEditor.caret=${palette.text}
textEditor.border=${palette.border}
textEditor.focus=${palette.accent}
textEditor.invalid=${palette.invalid}
textEditor.cornerRadius=${metrics.cornerRadius}
textEditor.height=20
textEditor.preferredWidth=120
textEditor.overflowFadeWidth=10
textEditor.padding=1,4,1,4

menu.background=${palette.surface}
menu.hover=${state.hover}
menu.pressed=${state.pressed}
menu.text=${palette.text}
menu.textDisabled=${palette.textDisabled}
menu.accelerator=${palette.textSecondary}
menu.border=${palette.border}
menu.separator=${palette.border}
menu.arrow=${palette.text}
menu.cornerRadius=${metrics.cornerRadius}
menu.itemCornerRadius=2
menu.itemHeight=27
menu.separatorHeight=9
menu.minimumWidth=170
menu.itemHorizontalPadding=10
menu.columnGap=18
menu.padding=4,4,4,4
menu.shadow.color=rgba(0, 0, 0, 105)
menu.shadow.softness=9
menu.shadow.offsetX=0
menu.shadow.offsetY=3

menuBar.background=rgba(45, 45, 45, 255)
menuBar.text=${palette.text}
menuBar.textDisabled=${palette.textDisabled}
menuBar.hover=${state.hover}
menuBar.pressed=${state.pressed}
menuBar.active=${palette.accent}
menuBar.border=${palette.border}
menuBar.height=26
menuBar.itemHorizontalPadding=10
menuBar.itemGap=1
menuBar.cornerRadius=${metrics.cornerRadius}

comboBox.text=${palette.text}
comboBox.arrow=${palette.text}
comboBox.pressedLight=${button.pressedLight}
comboBox.pressedDark=${button.pressedDark}
comboBox.cornerRadius=4
comboBox.minimumWidth=120
comboBox.arrowAreaWidth=22
comboBox.arrowStrokeWidth=1.5
comboBox.padding=1,7,1,7

scrollBar.track=rgba(37, 37, 37, 160)
scrollBar.thumb=${palette.textSecondary}
scrollBar.thumbHover=${palette.text}
scrollBar.thumbPressed=${palette.accent}
scrollBar.thumbDisabled=${state.disabled}
scrollBar.thickness=9
scrollBar.minimumThumbLength=18
scrollBar.trackPadding=2
scrollBar.cornerRadius=4

scrollPane.background=${palette.surface}
scrollPane.border=${palette.border}
scrollPane.borderWidth=${metrics.borderWidth}
scrollPane.cornerRadius=${metrics.cornerRadius}
scrollPane.scrollBarGap=2
scrollPane.padding=4,4,4,4
scrollPane.viewportBorder=${list.background}
scrollPane.viewportBorderWidth=${metrics.borderWidth}

list.background=${textEditor.background}
list.rowBackground=rgba(0, 0, 0, 0)
list.rowHoverBackground=${state.hover}
list.rowPressedBackground=${state.pressed}
list.selectionBackground=${palette.selection}
list.selectionInactiveBackground=derive(${palette.selection}, alpha*=0.67)
list.text=${palette.text}
list.selectedText=${palette.text}
list.textDisabled=${palette.textDisabled}
list.border=${palette.border}
list.focus=${palette.accent}
list.cornerRadius=${metrics.cornerRadius}
list.borderWidth=${metrics.borderWidth}
list.rowHeight=28
list.preferredWidth=180
list.cellPadding=3,8,3,8

tree.indent=18
tree.disclosureSize=11
tree.disclosureHover=${state.hover}
tree.disclosurePressed=${state.pressed}
tree.disclosureCornerRadius=3
tree.iconSize=18
tree.iconGap=6

tabbedPane.background=${palette.surface}
tabbedPane.tabBarBackground=${menuBar.background}
tabbedPane.tab=${state.normal}
tabbedPane.tabHover=${state.hover}
tabbedPane.tabPressed=${state.pressed}
tabbedPane.tabSelected=${palette.accent}
tabbedPane.tabDisabled=${state.disabled}
tabbedPane.text=${palette.text}
tabbedPane.textDisabled=${palette.textDisabled}
tabbedPane.border=${palette.border}
tabbedPane.borderWidth=${metrics.borderWidth}
tabbedPane.cornerRadius=${metrics.cornerRadius}
tabbedPane.tabHeight=28
tabbedPane.minimumTabWidth=72
tabbedPane.maximumTabWidth=220
tabbedPane.tabGap=2
tabbedPane.tabHorizontalPadding=12
tabbedPane.contentPadding=0,0,0,0

nodeEditor.background=rgba(35, 35, 35, 255)
nodeEditor.gridVisible=true
nodeEditor.gridMinor=rgba(255, 255, 255, 10)
nodeEditor.gridMajor=rgba(255, 255, 255, 24)
nodeEditor.gridSpacing=24
nodeEditor.gridMajorInterval=4
nodeEditor.gridLineWidth=1
nodeEditor.connectionSnapDistance=18
nodeEditor.connectionCurveTolerance=0.01
nodeEditor.connectionHandleFactor=0.55
nodeEditor.minimumConnectionHandleLength=50
nodeEditor.connectionWidth=3
nodeEditor.connectionBorder=${palette.border}
nodeEditor.selectedConnectionBorder=${palette.accent}
nodeEditor.warningConnectionBorder=rgb(224, 154, 45)
nodeEditor.errorConnectionBorder=rgb(222, 70, 70)
nodeEditor.connectionBorderWidth=1
nodeEditor.connectionColorInterpolation=srgb
nodeEditor.marqueeFill=derive(${palette.selection}, alpha*=0.5)
nodeEditor.marqueeBorder=${palette.accent}
nodeEditor.marqueeBorderWidth=1
codeEditor.overviewRulerWidth=7
codeEditor.overviewRulerGap=3
codeEditor.overviewMarkerHeight=3
codeEditor.overviewRulerBackground=rgba(0, 0, 0, 25)
codeEditor.colorPreviewSize=11
codeEditor.colorPreviewGap=6
codeEditor.colorPreviewBorder=${palette.border}
codeEditor.colorPreviewCheckerLight=rgba(225, 225, 225, 255)
codeEditor.colorPreviewCheckerDark=rgba(145, 145, 145, 255)
codeEditor.inlay.background=rgba(67, 69, 72, 255)
codeEditor.inlay.border=rgba(90, 93, 97, 255)
codeEditor.inlay.text=rgba(187, 191, 196, 255)
codeEditor.inlay.fontScale=0.78
codeEditor.inlay.padding=4
codeEditor.inlay.gap=3
codeEditor.inlay.radius=3
codeEditor.inlay.borderWidth=1
node.background=${palette.surface}
node.titleBackground=${state.normal}
node.titleGradientLight=rgba(103, 103, 103, 255)
node.titleGradientDark=rgba(77, 77, 77, 255)
node.titleText=${palette.text}
node.collapseChevron=${palette.textSecondary}
node.collapseChevronHover=${palette.accent}
node.border=${palette.border}
node.selectedBorder=rgba(190, 70, 70, 255)
node.activeSelectedBorder=rgba(200, 200, 200, 255)
node.shadow=rgba(0, 0, 0, 105)
node.inputPort=rgba(112, 174, 232, 255)
node.outputPort=rgba(237, 157, 91, 255)
node.portBorder=${palette.border}
node.portHover=${palette.text}
node.cornerRadius=9
node.borderWidth=1.5
node.titleHeight=30
node.collapseChevronSize=7
node.collapseChevronHitSize=20
node.collapseChevronWidth=1.5
node.shadowSoftness=10
node.shadowOffsetX=0
node.shadowOffsetY=4
node.portRadius=5
node.rowGap=9
node.minimumWidth=190
node.resizeHandleSize=7
node.contentPadding=11,12,12,12
node.mutedBypass=rgba(224, 72, 72, 255)
node.mutedBypassWidth=2
node.opacity=0.95
node.mutedOpacity=0.62
dialog.cornerRadius=10
dialog.titleBar.height=34
dialog.titleBar.background=${palette.surface}
dialog.titleBar.text=${palette.text}
dialog.titleBar.border=${palette.border}
dialog.titleBar.borderWidth=1
dialog.close.text=${palette.text}
dialog.close.activeText=rgba(255, 255, 255, 255)
dialog.close.hover=rgba(196, 43, 28, 255)
dialog.close.pressed=rgba(153, 32, 22, 255)
dialog.border=${palette.border}
dialog.borderWidth=1
dialog.shadow.color=rgba(0, 0, 0, 120)
dialog.shadow.softness=12
dialog.shadow.offsetX=0
dialog.shadow.offsetY=4
layoutGroup.focusBorder=${palette.accent}
