# Explicit GLSwing theme-property schema. No key-name or value heuristics are used.
schema.name=GLSwing Core
schema.version=1

theme.name=TEXT, "Human-readable theme name.", fragment=meta
theme.extends=PATH, "Inherited theme file or built-in preset.", fragment=meta
theme.type=ENUM, "Role of the theme document.", values=colors|metrics|bundle, fragment=meta
theme.colors=PATH, "Color fragment imported by a bundle.", fragment=meta
theme.metrics=PATH, "Metrics fragment imported by a bundle.", fragment=meta
theme.schema=PATH, "Schema file or directory imported by a bundle.", fragment=meta

font.family=TEXT, "Value of the font.family theme property.", fragment=colors
font.style=ENUM, "Value of the font.style theme property.", values=plain|bold|italic|bolditalic|bold_italic|bold-italic, fragment=colors
font.size=NUMBER, "Value of the font.size theme property.", fragment=colors
