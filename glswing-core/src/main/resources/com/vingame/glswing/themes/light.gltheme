theme.name=Light
theme.extends=default

palette.surface=rgba(244, 245, 247, 255)
palette.text=rgba(37, 39, 43, 255)
palette.textDisabled=rgba(138, 143, 152, 255)
palette.textSecondary=rgba(102, 108, 117, 255)
palette.border=rgba(174, 180, 190, 255)
palette.accent=rgba(66, 120, 199, 255)
palette.selection=rgba(66, 120, 199, 77)
palette.invalid=rgba(198, 69, 69, 255)

codeEditor.background=rgba(255, 255, 255, 255)
codeEditor.text=rgba(37, 39, 43, 255)
codeEditor.keyword=rgba(128, 35, 145, 255)
codeEditor.string=rgba(38, 112, 55, 255)
codeEditor.number=rgba(154, 86, 24, 255)
codeEditor.comment=rgba(82, 112, 72, 255)
codeEditor.type=rgba(20, 112, 128, 255)
codeEditor.navigationLink=rgba(35, 103, 190, 255)
codeEditor.semantic.namespace=rgba(20, 112, 128, 255)
codeEditor.semantic.type=${codeEditor.type}
codeEditor.semantic.class=rgba(35, 103, 190, 255)
codeEditor.semantic.class.abstract=${codeEditor.semantic.class}
codeEditor.semantic.class.static=${codeEditor.keyword}
codeEditor.semantic.enum=rgba(154, 86, 24, 255)
codeEditor.semantic.interface=${codeEditor.type}
codeEditor.semantic.struct=${codeEditor.type}
codeEditor.semantic.typeParameter=${codeEditor.keyword}
codeEditor.semantic.parameter=rgba(35, 103, 190, 255)
codeEditor.semantic.variable=rgba(133, 91, 18, 255)
codeEditor.semantic.variable.declaration=${codeEditor.semantic.variable}
codeEditor.semantic.variable.readonly=${codeEditor.number}
codeEditor.semantic.variable.static=${codeEditor.number}
codeEditor.semantic.property=rgba(176, 55, 67, 255)
codeEditor.semantic.property.readonly=${codeEditor.number}
codeEditor.semantic.property.static=${codeEditor.number}
codeEditor.semantic.enumMember=${codeEditor.number}
codeEditor.semantic.event=rgba(176, 55, 67, 255)
codeEditor.semantic.function=rgba(38, 112, 55, 255)
codeEditor.semantic.function.abstract=${codeEditor.semantic.function}
codeEditor.semantic.function.declaration=${codeEditor.semantic.function}
codeEditor.semantic.function.definition=${codeEditor.semantic.function}
codeEditor.semantic.function.static=${codeEditor.semantic.function}
codeEditor.semantic.method=rgba(38, 112, 55, 255)
codeEditor.semantic.method.abstract=${codeEditor.semantic.method}
codeEditor.semantic.method.declaration=${codeEditor.semantic.method}
codeEditor.semantic.method.definition=${codeEditor.semantic.method}
codeEditor.semantic.method.static=${codeEditor.semantic.method}
codeEditor.semantic.macro=${codeEditor.keyword}
codeEditor.semantic.modifier=${codeEditor.keyword}
codeEditor.semantic.regexp=${codeEditor.string}
codeEditor.semantic.operator=${codeEditor.keyword}
codeEditor.semantic.decorator=rgba(133, 91, 18, 255)
codeEditor.semantic.*.deprecated=${palette.textDisabled}
codeEditor.inlay.background=rgba(225, 228, 233, 255)
codeEditor.inlay.border=rgba(190, 195, 203, 255)
codeEditor.inlay.text=rgba(91, 96, 104, 255)
codeEditor.inlay.fontScale=0.78
codeEditor.inlay.padding=4
codeEditor.inlay.gap=3
codeEditor.inlay.radius=3
codeEditor.inlay.borderWidth=1

state.normal=rgba(225, 228, 233, 255)
state.hover=rgba(210, 216, 226, 255)
state.disabled=rgba(236, 238, 241, 255)

button.pressedLight=rgba(89, 136, 206, 255)
button.pressedDark=rgba(58, 106, 175, 255)
menuBar.background=rgba(231, 233, 237, 255)
slider.pressed=rgba(240, 243, 248, 255)
slider.progressLight=rgba(120, 162, 226, 255)
slider.progressDark=rgba(77, 120, 185, 255)
textEditor.background=rgba(255, 255, 255, 255)
dialog.cornerRadius=10
dialog.titleBar.height=34
dialog.titleBar.background=${palette.surface}
dialog.titleBar.text=${palette.text}
dialog.titleBar.border=${palette.border}
dialog.titleBar.borderWidth=1
dialog.close.text=${palette.text}
dialog.close.activeText=rgba(255, 255, 255, 255)
dialog.close.hover=rgba(196, 43, 28, 255)
dialog.close.pressed=rgba(153, 32, 22, 255)
dialog.border=${palette.border}
dialog.borderWidth=1
dialog.shadow.color=rgba(0, 0, 0, 90)
dialog.shadow.softness=12
dialog.shadow.offsetX=0
dialog.shadow.offsetY=4
layoutGroup.focusBorder=${palette.accent}
