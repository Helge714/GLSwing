# Keep repository text deterministic across Windows, macOS, and Linux.
* text=auto eol=lf

# Windows command scripts require their native line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never attempt line-ending conversion for binary artifacts.
*.class binary
*.jar binary
*.zip binary
*.7z binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.pdf binary
